@'
# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─────────────────────────────────────────────────────────────
# Virtual Environments
# ─────────────────────────────────────────────────────────────
venv/
env/
ENV/
.venv/
.conda/
env.bak/
venv.bak/

# ─────────────────────────────────────────────────────────────
# Environment Variables / Secrets
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
secrets.toml
.streamlit/secrets.toml

# ─────────────────────────────────────────────────────────────
# Streamlit
# ─────────────────────────────────────────────────────────────
.streamlit/secrets.toml
.streamlit/cache/

# ─────────────────────────────────────────────────────────────
# HuggingFace / Sentence-Transformers cache
# ─────────────────────────────────────────────────────────────
.cache/
huggingface/
*.safetensors

# ─────────────────────────────────────────────────────────────
# Jupyter Notebooks
# ─────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─────────────────────────────────────────────────────────────
# Testing / Coverage
# ─────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# ─────────────────────────────────────────────────────────────
# Logs & Databases
# ─────────────────────────────────────────────────────────────
*.log
*.sqlite
*.db

# ─────────────────────────────────────────────────────────────
# IDEs & Editors
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.spyderproject
.spyproject
.ropeproject

# ─────────────────────────────────────────────────────────────
# OS Junk
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─────────────────────────────────────────────────────────────
# Project-specific
# ─────────────────────────────────────────────────────────────
# Uncomment the next line if you DON'T want to commit the
# pre-built FAISS index (forces re-ingestion on clone/deploy).
# faiss_index/

# Keep the source PDFs tracked:
!knowledge_base/
!knowledge_base/*.pdf

# Keep the Streamlit config tracked:
!.streamlit/config.toml
'@ | Out-File -FilePath .gitignore -Encoding utf8